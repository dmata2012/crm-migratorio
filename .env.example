# ── Base de datos ─────────────────────────────────────────────
# Cadena de conexión de PostgreSQL. En desarrollo se recomienda una base
# gratuita en la nube (Neon o Supabase): copias aquí la cadena que te dan y
# no instalas nada en tu computadora.
DATABASE_URL="postgresql://usuario:contrasena@host:5432/crm?sslmode=require"

# ── Sesiones ──────────────────────────────────────────────────
# Clave con la que se firman las sesiones. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA uses la misma en desarrollo y en producción.
AUTH_SECRET="cambia-esta-clave"

# ── Producción ────────────────────────────────────────────────
# Dirección pública del sistema. En local no hace falta.
# AUTH_URL="https://crm.tudominio.mx"

# ── Servidor de correo ────────────────────────────────────────
# Mientras estas variables falten, el sistema no envía: lo dice en pantalla
# y deja registrar el envío a mano. No inventa que mandó nada.
# SMTP_HOST="smtp.tuproveedor.com"
# SMTP_PUERTO="587"              # 465 si el proveedor pide TLS directo
# SMTP_USUARIO="despacho@grupomanagement.mx"
# SMTP_CLAVE="la-contrasena-del-buzon"
# CORREO_REMITENTE="despacho@grupomanagement.mx"
# CORREO_NOMBRE="Grupo Management"
